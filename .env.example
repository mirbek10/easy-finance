# ==============================================================================
# izy.finance - Frontend Environment Configuration (Vercel / Production)
# ==============================================================================

# Backend API URL (Render Web Service)
# Next.js will proxy /api/* and /health/* requests to this URL.
# Replace with your actual Render service URL (without trailing slash).
API_URL=https://easy-finance-server.onrender.com

# Direct WebSocket URL (Render Web Service)
# Next.js on Vercel cannot maintain long-lived WebSocket connections, so the
# browser connects directly to Render using an encrypted session ticket.
NEXT_PUBLIC_WS_URL=wss://easy-finance-server.onrender.com/ws
